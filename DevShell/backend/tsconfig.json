{
  "compilerOptions" : {
    "target": "esnext",
    "module": "nodenext",
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
  }
}